<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:padding="12dp"
    android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/moscow" android:textSize="18sp" android:textStyle="bold" android:textColor="#F4EFFA" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_preview_temperature" android:textSize="32sp" android:textStyle="bold" android:textColor="#F4EFFA" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/widget_preview_icon" android:textSize="52sp" android:textStyle="bold" android:textColor="#F4EFFA" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/condition_partly_cloudy" android:textSize="14sp" android:textStyle="bold" android:textColor="#F4EFFA" />
</LinearLayout>
